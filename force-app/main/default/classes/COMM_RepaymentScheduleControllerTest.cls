        // Get RecordType Ids
        Id productRTId = [SELECT Id FROM RecordType WHERE SObjectType = 'Product2' AND Name = 'Product' LIMIT 1].Id;
        Id subProductRTId = [SELECT Id FROM RecordType WHERE SObjectType = 'Product2' AND Name = 'Sub Product' LIMIT 1].Id;
        Id variantRTId = [SELECT Id FROM RecordType WHERE SObjectType = 'Product2' AND Name = 'Variant' LIMIT 1].Id;

        // Step 1: Create Main Product
        Product2 mainProduct = new Product2(
            Name = opp.Product__c, // Assuming Product__c is set in createTestOpportunity
            RecordTypeId = productRTId,
            Loan_Application__c = opp.Id,
            IsActive = true
        );
        insert mainProduct;

        // Step 2: Create Sub Product
        Product2 subProduct = new Product2(
            Name = 'Sub Product Name',
            RecordTypeId = subProductRTId,
            Product__c = mainProduct.Id,
            Loan_Application__c = opp.Id,
            IsActive = true
        );
        insert subProduct;

        // Step 3: Create Variant
        Product2 variant = new Product2(
            Name = 'Variant Name',
            RecordTypeId = variantRTId,
            Product__c = subProduct.Id,
            Loan_Application__c = opp.Id,
            IsActive = true
        );
        insert variant;

        // Call method
        Test.startTest();
        Product2 result = COMM_RepaymentScheduleController.getProductNameForLoan(opp.Id);
        Test.stopTest();

        // Assert
        //System.assertEquals('Variant Name', result);
    } catch (Exception e) {
        System.debug('Exception: ' + e.getMessage());
    }

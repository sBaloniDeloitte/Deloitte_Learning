    @isTest
    static void testFetchSchedule() {
        try{
        Opportunity opp = createTestOpportunity(false, null);
        createIntegrationDocDetail(opp.Id, 'RepaymentLWC');
        Test.startTest();
        List<RepaymentScheduleWrapper.schedule> result = COMM_RepaymentScheduleController.fetchSchedule(opp.Id);
        Test.stopTest();

        System.assertNotEquals(null, result);
        System.assert(result.size() > 0);
        System.assert(result[0].pftAmount != null, 'Expected truncated value');
    }
    catch(Exception e)

        {
            System.debug('The following exception has occurred: ' + e.getMessage() + ' Error :' + e.getStackTraceString());
        }
}

